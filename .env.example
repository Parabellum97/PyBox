# PyBox 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Kernel Gateway 地址 (内部网络,无需修改)
KERNEL_GATEWAY_URL=http://kernel:8888

# 数据持久化目录 (容器内路径,无需修改)
DATA_DIR=/mnt/data

# 对外端口 (在 docker-compose.yml 中配置)
# API_PORT=6811

WS_MAX_SIZE=5242880

# 代码执行超时时间(秒)
# DEFAULT_TIMEOUT=60

# 是否启用调试模式
# DEBUG=false
